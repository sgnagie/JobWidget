<Window x:Class="JobWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Job Widget Settings"
        Width="400" Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border CornerRadius="12" Background="#DD1E1E2E" BorderBrush="#553A3A5C" BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Settings" Foreground="White" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button x:Name="CloseButton" Content="✕" Width="24" Height="24"
                        HorizontalAlignment="Right" Background="Transparent" Foreground="White"
                        BorderThickness="0" Cursor="Hand" Click="CloseButton_Click" FontSize="14"/>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <!-- Search Settings Section -->
                    <TextBlock Text="Search Settings" Foreground="White" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                    
                    <TextBlock Text="Keyword:" Foreground="#AAB0B8C0" FontSize="11"/>
                    <TextBox x:Name="KeywordTextBox" Background="#2A2A3E" Foreground="White" 
                             Padding="8" Height="32" Margin="0,0,0,12"/>

                    <TextBlock Text="Location:" Foreground="#AAB0B8C0" FontSize="11"/>
                    <TextBox x:Name="LocationTextBox" Background="#2A2A3E" Foreground="White" 
                             Padding="8" Height="32" Margin="0,0,0,12"/>

                    <TextBlock Text="Minimum Salary:" Foreground="#AAB0B8C0" FontSize="11"/>
                    <TextBox x:Name="SalaryTextBox" Background="#2A2A3E" Foreground="White" 
                             Padding="8" Height="32" Margin="0,0,0,12"/>

                    <TextBlock Text="Work Mode:" Foreground="#AAB0B8C0" FontSize="11"/>
                    <ComboBox x:Name="WorkModeComboBox" Background="#2A2A3E" Foreground="White"
                            Padding="8" Height="32" Margin="0,0,0,12">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2A2A3E"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2A2A3E"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2A2A3E" />
                        </ComboBox.Resources>
                        <ComboBoxItem Content="Any"/>
                        <ComboBoxItem Content="Remote"/>
                        <ComboBoxItem Content="Hybrid"/>
                        <ComboBoxItem Content="On-site"/>
                    </ComboBox>

                    <!-- Refresh Settings Section -->
                    <TextBlock Text="Refresh Settings" Foreground="White" FontSize="12" FontWeight="Bold" Margin="0,12,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Auto-Refresh" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                VerticalAlignment="Center"/>
                    <CheckBox x:Name="AutoRefreshEnabledCheckBox" Grid.Column="1" Background="White" 
                            Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0">
                        <CheckBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="White"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="White"/>
                        </CheckBox.Resources>
                    </CheckBox>
                    </Grid>

                    <TextBlock Text="Refresh Interval (minutes):" Foreground="#AAB0B8C0" FontSize="11"/>
                    <TextBox x:Name="RefreshIntervalTextBox" Background="#2A2A3E" Foreground="White" 
                            Padding="8" Height="32" Margin="0,0,0,12"/>

                    <!-- Job Sources Section -->
                    <TextBlock Text="Job Sources" Foreground="White" FontSize="12" FontWeight="Bold" Margin="0,12,0,8"/>
                    
                    <!-- Adzuna Source -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Adzuna" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    <CheckBox x:Name="AdzunaEnabledCheckBox" Grid.Column="1" Background="White" 
                            Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"
                            Click="AdzunaEnabledCheckBox_Click">
                        <CheckBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="White"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="White"/>
                        </CheckBox.Resources>
                    </CheckBox>
                    </Grid>

                    <!-- Adzuna API Keys (shown/hidden based on checkbox) -->
                    <StackPanel x:Name="AdzunaKeysPanel" Visibility="Collapsed">
                        <TextBlock Text="Adzuna App ID:" Foreground="#AAB0B8C0" FontSize="11"/>
                        <TextBox x:Name="AdzunaAppIdTextBox" Background="#2A2A3E" Foreground="White" 
                                 Padding="8" Height="32" Margin="0,0,0,8"/>

                        <TextBlock Text="Adzuna App Key:" Foreground="#AAB0B8C0" FontSize="11"/>
                        <TextBox x:Name="AdzunaAppKeyTextBox" Background="#2A2A3E" Foreground="White" 
                                 Padding="8" Height="32" Margin="0,0,0,12"/>
                    </StackPanel>

                    <!-- Remotive Source (no API key needed) -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Remotive (remote jobs)" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    <CheckBox x:Name="RemotiveEnabledCheckBox" Grid.Column="1" Background="White" 
                            Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0">
                        <CheckBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="White"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="White"/>
                        </CheckBox.Resources>
                    </CheckBox>
                    </Grid>

                    <!-- Jooble Source -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Jooble" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    <CheckBox x:Name="JoobleEnabledCheckBox" Grid.Column="1" Background="White" 
                            Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"
                            Click="JoobleEnabledCheckBox_Click">
                        <CheckBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="White"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="White"/>
                        </CheckBox.Resources>
                    </CheckBox>
                    </Grid>

                    <!-- Jooble API Key (shown/hidden based on checkbox) -->
                    <StackPanel x:Name="JoobleKeyPanel" Visibility="Collapsed">
                        <TextBlock Text="Jooble API Key:" Foreground="#AAB0B8C0" FontSize="11"/>
                        <TextBox x:Name="JoobleApiKeyTextBox" Background="#2A2A3E" Foreground="White" 
                                 Padding="8" Height="32" Margin="0,0,0,12"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="SaveButton" Content="Save" Width="80" Height="32"
                        Background="#4A7C59" Foreground="White" BorderThickness="0" 
                        Cursor="Hand" Click="SaveButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="32"
                        Background="#3A3A5C" Foreground="White" BorderThickness="0" 
                        Cursor="Hand" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
