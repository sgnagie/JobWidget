<Window x:Class="JobWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Job Widget"
        Icon="Assets/app.ico"
        Width="340" Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border CornerRadius="12" Background="#DD1E1E2E" BorderBrush="#553A3A5C" BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="Job Postings" Foreground="White" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SettingsButton" Content="⚙" Width="24" Height="24"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Click="SettingsButton_Click"
                            FontSize="14" Margin="0,0,4,0"/>
                    <Button x:Name="CloseButton" Content="✕" Width="24" Height="24"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Scrolling job list -->
            <ScrollViewer x:Name="JobScrollViewer" Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="JobItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#333A3A5C" BorderThickness="0,0,0,1" Padding="0,8"
                                    Cursor="Hand" Background="Transparent"
                                    MouseLeftButtonDown="JobItem_MouseLeftButtonDown">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13"
                                               FontWeight="SemiBold" TextWrapping="Wrap"
                                               TextDecorations="Underline"/>
                                    <TextBlock Text="{Binding Company}" Foreground="#CCB0B8C0" FontSize="11"
                                               FontStyle="Italic" Margin="0,1,0,0" TextWrapping="Wrap"/>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Location}" Foreground="#AAB0B8C0" 
                                                   FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SalaryDisplay}" Foreground="#88D4A8A8" 
                                                   FontSize="10" Margin="8,0,0,0" TextWrapping="Wrap"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer / status -->
            <TextBlock x:Name="StatusText" Grid.Row="2" Text="Loading..." Foreground="#88AAB0C0"
                       FontSize="10" Margin="0,6,0,0" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>